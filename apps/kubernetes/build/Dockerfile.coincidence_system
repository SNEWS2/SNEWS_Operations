FROM snews_base:latest

# Set working directory
WORKDIR /app

# Accept build arguments
# SNEWS_MODE: prod or dev
ARG DOCKER_USER
ARG SNEWS_MODE
ARG HOP_USERNAME
ARG HOP_PASSWORD

# Set environment variables
ENV DOCKER_USER=${DOCKER_USER}
ENV SNEWS_MODE=${SNEWS_MODE}
ENV HOP_USERNAME=${HOP_USERNAME}
ENV HOP_PASSWORD=${HOP_PASSWORD}

# Clone the repository
ARG REPO_URL
ARG BRANCH

USER ${DOCKER_USER}

#RUN git clone --branch ${BRANCH} ${REPO_URL} .
COPY --chown=${DOCKER_USER} SNEWS_Coincidence_System /app/

RUN sed -i 's/^FIREDRILL_OBSERVATION_TOPIC=.*/FIREDRILL_OBSERVATION_TOPIC=kafka:\/\/$\{HOP_BROKER\}\/snews2-exp\.experiments-firedrill/' /app/snews_cs/etc/test-config.env
RUN sed -i 's/^FIREDRILL_ALERT_TOPIC=.*/FIREDRILL_ALERT_TOPIC=kafka:\/\/$\{HOP_BROKER\}\/snews2\.alert-firedrill/' /app/snews_cs/etc/test-config.env
RUN sed -i 's/^OBSERVATION_TOPIC=.*/OBSERVATION_TOPIC=kafka:\/\/\$\{HOP_BROKER\}\/snews2-exp\.experiments/' /app/snews_cs/etc/test-config.env
RUN sed -i 's/^ALERT_TOPIC=.*/ALERT_TOPIC=kafka:\/\/\$\{HOP_BROKER\}\/snews2\.alert/' /app/snews_cs/etc/test-config.env
RUN sed -i 's/^CONNECTION_TEST_TOPIC=.*/CONNECTION_TEST_TOPIC=kafka:\/\/\$\{HOP_BROKER\}\/snews2-exp\.connection-testing/' /app/snews_cs/etc/test-config.env

# Copy credentials into the container
COPY --chown=${DOCKER_USER} --chmod=700 generate_firedrill_creds.sh init_creds.sh /app
# RUN chmod +x /app/generate_firedrill_creds.sh /app/init_creds.sh

# Install dependencies using Poetry
RUN poetry lock
RUN poetry install
#
## Command to run the coincidence system
# ENTRYPOINT ["/app/init_creds.sh"] 
CMD ["/app/init_creds.sh", "poetry run snews_cs run-coincidence --no-firedrill"]
