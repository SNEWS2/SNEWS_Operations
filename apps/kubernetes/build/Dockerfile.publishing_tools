FROM snews_base:latest

WORKDIR /app

SHELL ["/bin/bash", "-c"]

# Accept build arguments
ARG DOCKER_USER
ARG SNEWS_MODE
ARG HOP_USERNAME
ARG HOP_PASSWORD

# Set environment variables
ENV DOCKER_USER=${DOCKER_USER}
ENV SNEWS_MODE=${SNEWS_MODE}
ENV HOP_USERNAME=${HOP_USERNAME}
ENV HOP_PASSWORD=${HOP_PASSWORD}

ARG REPO_URL
ARG BRANCH

USER ${DOCKER_USER}

# RUN git clone --branch ${BRANCH} ${REPO_URL} .
COPY --chown=${DOCKER_USER} SNEWS_Publishing_Tools /app/

# Set observation and alert topics for github CI firedrill
RUN sed -i 's/^FIREDRILL_OBSERVATION_TOPIC=.*/FIREDRILL_OBSERVATION_TOPIC=kafka:\/\/$\{HOP_BROKER\}\/snews2-exp\.experiments/' /app/snews_pt/auxiliary/test-config.env
RUN sed -i 's/^FIREDRILL_ALERT_TOPIC=.*/FIREDRILL_ALERT_TOPIC=kafka:\/\/$\{HOP_BROKER\}\/snews2\.alert/' /app/snews_pt/auxiliary/test-config.env

# Install dependencies using Poetry
RUN poetry lock
RUN poetry install

COPY --chown=${DOCKER_USER} --chmod=755 generate_firedrill_creds.sh init_creds.sh /app/
# RUN chmod +x /app/generate_firedrill_creds.sh
RUN /app/generate_firedrill_creds.sh

# Install the project
#RUN pip install .
#RUN hop auth add hop_creds.csv
RUN mkdir -p /app/output
#RUN snews_pt set-name -n JUNO

# Command to keep the container running
CMD ["tail", "-f", "/dev/null"]
