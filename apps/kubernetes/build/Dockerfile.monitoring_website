FROM snews_base:latest

WORKDIR /app

USER root
SHELL ["/bin/bash", "-c"]

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm


# Accept build arguments
ARG DATABASE_URL
ARG BRANCH
ARG REPO_URL
ARG DOCKER_USER

# Set environment variables
ENV DATABASE_URL=${DATABASE_URL}
ENV DOCKER_USER=${DOCKER_USER}
ENV SNEWS_MODE=${SNEWS_MODE}

# Backend
COPY --chown=${DOCKER_USER} SNEWS_Monitoring_Website /app/
#RUN git clone --branch ${BRANCH} ${REPO_URL} && \

USER ${DOCKER_USER}

WORKDIR /app/SNEWS_Monitoring_Website/backend
